# MySQL 8 (Compose service `mysql`; host port defaults to 3307)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=sistema-esp8266
MYSQL_USER=sistema_iot
MYSQL_PASSWORD=change-me-user
MYSQL_PORT=3307

# Backend Spring Boot (Compose service `backend`)
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod
# openssl rand -base64 48 — minimum length enforced by the application (32+)
JWT_SECRET=change-me-change-me-change-me-change-me-change-me-change-me

# Bootstrap admin when the database is empty (production profile)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!2026

# CORS — comma-separated origins for the browser UI
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MQTT (must match between Mosquitto entrypoint and backend)
MQTT_USERNAME=mqtt_user
MQTT_PASSWORD=change-me-mqtt
MQTT_HOST_PORT=1883
MQTT_WS_PORT=9001

# Frontend Next.js (Compose service `frontend`)
FRONTEND_PORT=3000
# Leave empty in Docker: Next rewrites /api/* to BACKEND_PROXY_TARGET (see frontend Dockerfile).
NEXT_PUBLIC_API_URL=
