# MQTT ACL (Access Control List)
# Format: topic [read|write|readwrite] <topic_pattern>
# 
# Allow authenticated users to read/write to tuya topics
user ADMIN
topic readwrite tuya/+/command
topic readwrite tuya/+/query
topic readwrite tuya/+/state

# /iot/entrada/presenca e /iot/sensores/ac/estado nao cabem no mesmo numero de niveis
topic readwrite /iot/#
