{
    "name": "node-red-project",
    "description": "A Node-RED Project",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "start": "concurrently \"npm:docker\" \"npm:nodered\" \"npm:springboot\" \"npm:frontend\" \"npm:tuya-bridge\"",
        "docker": "docker compose up",
        "nodered": "cd node-red && npm start",
        "springboot": "cd sistema-esp8266/app && mvnw.cmd spring-boot:run",
        "frontend": "cd frontend && npm run dev",
        "tuya-bridge": "node tuya-mqtt-bridge.js",
        "stop": "docker compose down"
    },
    "devDependencies": {
        "concurrently": "^8.2.2",
        "mqtt": "^5.10.0",
        "tuyapi": "^7.7.1"
    }
}